rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the logged-in user matches a path parameter (e.g. /users/{userId})
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Checks if an existing document belongs to the logged-in user
    function isDocOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Ensures new documents explicitly set the logged-in user as the owner
    function isCreatingOwnDoc() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------

    // 1. Users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Products Collection
    match /products/{productId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isCreatingOwnDoc();
    }

    // 3. Sales Collection
    match /sales/{saleId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isCreatingOwnDoc();
    }

    // 4. Insights Collection
    match /insights/{insightId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isCreatingOwnDoc();
    }
  }
}